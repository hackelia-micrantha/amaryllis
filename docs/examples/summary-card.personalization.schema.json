{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "summary-card Personalization Contract",
  "description": "Schema for on-device personalization of summary-card v0.1.0",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "maxLength": 240
        },
        "variant": {
          "type": "string",
          "enum": [
            "compact",
            "expanded"
          ]
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "variant": {
      "type": "string",
      "enum": [
        "compact",
        "expanded"
      ]
    },
    "slots": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 240
        }
      },
      "additionalProperties": false
    },
    "designTokens": {
      "type": "object",
      "properties": {
        "spacingSm": {
          "type": "string"
        },
        "spacingMd": {
          "type": "string"
        },
        "bodySm": {
          "type": "string"
        },
        "bodyMd": {
          "type": "string"
        },
        "surfacePrimary": {
          "type": "string"
        },
        "textPrimary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
