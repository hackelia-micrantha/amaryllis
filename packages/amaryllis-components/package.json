{
  "name": "@micrantha/amaryllis-components",
  "version": "0.1.0",
  "description": "Companion module for Amaryllis defining personalized React components as governed specs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "./dist/cli/index.js",
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "amaryllis",
    "react",
    "ai",
    "components",
    "generative-ui"
  ],
  "author": "Ryan Jennings",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^14.0.3",
    "fast-json-patch": "^3.1.1",
    "js-yaml": "^4.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.41",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70"
  }
}
